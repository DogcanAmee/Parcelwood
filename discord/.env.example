# Discord build settings. Copy to discord/.env.local. None of these is secret.
# Leave VITE_DISCORD_CLIENT_ID or VITE_SUPABASE_PUBLISHABLE_KEY empty to run the local mock (npm run dev:discord).
VITE_DISCORD_CLIENT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Developer Portal > Activities > URL Mappings must map this prefix to <project>.supabase.co
VITE_DISCORD_SB_PREFIX=/sb
# SKU ids from Developer Portal > Monetization > SKUs
VITE_DISCORD_SKU_GEMS60=
VITE_DISCORD_SKU_GEMS330=
VITE_DISCORD_SKU_OUTFIT=
