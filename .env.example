# Copy to .env.local and fill in from the Supabase project's API settings.
# Leave both empty to run with the local mock (no server, sign-in simulated in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. M1 uses test mode only. Leave empty for the built-in local test ad.
# With a publisher id the web build loads Google H5 Games Ads with data-adbreak-test="on" (mock ads).
VITE_ADSENSE_CLIENT=
